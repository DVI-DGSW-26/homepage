# Copy to .env.local and fill in. Server-side only (no NEXT_PUBLIC_ prefix, never in the browser bundle).
# On Vercel set them in Project Settings > Environment Variables and redeploy.
#
# Demo request form (#contact): src/server/inquiry.ts sends each request with Resend (https://resend.com).
# It uses the same Resend account and verified domain (dvi-ind.com) as the company site; see
# homepage_new docs/from.md. Unset: the form reports a send failure and shows the sales address.

# Resend API key (Resend > API Keys)
RESEND_API_KEY=
# Sender address on the domain verified in Resend. The visitor's name is shown as the sender name and
# their email is the Reply-To.
INQUIRY_MAIL_FROM=homepage@dvi-ind.com
# Recipient (default sales@dvi-ind.com)
INQUIRY_MAIL_TO=sales@dvi-ind.com
# Recipient while developing (`pnpm dev` only; replaces INQUIRY_MAIL_TO there). Leave it out on Vercel.
INQUIRY_MAIL_TO_DEV=

# Search engine ownership checks, added to every page's <head> when set (read at build time).
# Google Search Console > Settings > Ownership verification > HTML tag: the content value
GOOGLE_SITE_VERIFICATION=
# Naver Search Advisor (searchadvisor.naver.com) > 사이트 소유확인 > HTML 태그: the content value
NAVER_SITE_VERIFICATION=
