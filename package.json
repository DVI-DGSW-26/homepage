{
  "name": "dvision-homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DVISION (dvi-ind.com) homepage remake - React / Vite / Tailwind CSS / Three.js / GSAP",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "node scripts/images.mjs && vite",
    "build": "node scripts/images.mjs && tsc --noEmit && vite build && node scripts/single.mjs",
    "preview": "vite preview",
    "typecheck": "node scripts/images.mjs && tsc --noEmit",
    "images": "node scripts/images.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
